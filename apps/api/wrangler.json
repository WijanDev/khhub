{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khhub-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_SECRET": "change-this-in-production-use-random-32-chars",
    "EMAIL_PROVIDER": "resend",
    "UNOSEND_API_KEY": "un__RdFpQePN8lhpUQC9osOANVWO5QkJySE",
    "MAILGUN_API_KEY": "your-mailgun-api-key",
    "MAILGUN_DOMAIN": "your-mailgun-domain",
    "WEB_APP_URL": "http://localhost:5173",
    "RESEND_API_KEY": "re_fXSjZ9Ge_9urQp5nAjpnDu4xdHmyY4G9a"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khhub-db",
      "database_id": "YOUR_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "khhub-storage"
    }
  ]
}
