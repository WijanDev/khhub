{
  "name": "@khhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/node.ts",
    "build": "echo 'No build needed for Workers'",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply khhub-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply khhub-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "better-auth": "^1.4.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.54.0"
  }
}
