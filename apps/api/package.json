{
  "name": "@khhub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/node.ts",
    "build": "echo 'No build needed for Workers'",
    "start": "node dist/index.js",
    "db:migrate": "wrangler d1 migrations apply khhub-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply khhub-db --remote",
    "db:studio": "wrangler d1 execute khhub-db --local --command \"SELECT * FROM users\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^25.0.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
