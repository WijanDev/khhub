{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@auth/*": [
        "./src/features/auth/*"
      ],
      "@cache/*": [
        "./src/features/cache/*"
      ],
      "@email/*": [
        "./src/features/email/*"
      ],
      "@storage/*": [
        "./src/features/storage/*"
      ],
      "@tenants/*": [
        "./src/features/tenants/*"
      ],
      "@users/*": [
        "./src/features/users/*"
      ],
      "@tests/*": [
        "./tests/*"
      ]
    },
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}