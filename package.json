{
  "name": "khhub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:*\"",
    "dev:api": "npm run dev -w @khhub/api",
    "dev:web": "npm run dev -w @khhub/web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build -w @khhub/api",
    "build:web": "npm run build -w @khhub/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test -w @khhub/api",
    "test:web": "npm run test -w @khhub/web",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "zod": "^4.3.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-router-ssr-query": "^1.144.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vite": "^7.3.0"
  }
}